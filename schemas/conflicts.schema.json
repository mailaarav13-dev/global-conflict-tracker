{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-conflict-tracker.local/schemas/conflicts.schema.json",
  "title": "Global Conflict Tracker conflict snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "source", "items"],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/conflict" }
    }
  },
  "$defs": {
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "region",
        "type",
        "status",
        "impact_level",
        "scope",
        "iso_countries",
        "center_coordinates",
        "summary",
        "historical_context",
        "strategic_impact"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "region": {
          "enum": [
            "North America",
            "South America",
            "Europe",
            "Middle East & North Africa",
            "Sub-Saharan Africa",
            "Asia-Pacific"
          ]
        },
        "type": {
          "enum": [
            "Interstate War",
            "Civil War",
            "Transnational Terrorism",
            "Political Instability"
          ]
        },
        "status": { "enum": ["Deteriorating", "Constant", "Improving"] },
        "impact_level": { "enum": ["High", "Medium", "Low"] },
        "scope": { "enum": ["International", "Internal", "Transnational"] },
        "iso_countries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z]{3}$" }
        },
        "center_coordinates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        "summary": { "type": "string", "minLength": 1 },
        "historical_context": { "type": "string", "minLength": 1 },
        "strategic_impact": { "type": "string", "minLength": 1 },
        "updated_at": { "type": "string", "format": "date" },
        "source_links": {
          "type": "array",
          "items": { "type": "string", "format": "uri", "pattern": "^https?://" }
        }
      }
    }
  }
}
